<!DOCTYPE html>
<html lang="sv">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Klocka In/Ut</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin-top: 50px;
      background: #f5f5f5;
    }
    button {
      padding: 15px 30px;
      margin: 10px;
      font-size: 18px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
    }
    #in {
      background: #4caf50;
      color: white;
    }
    #ut {
      background: #f44336;
      color: white;
    }
    #log {
      margin-top: 30px;
      background: white;
      display: inline-block;
      padding: 15px;
      border-radius: 10px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    .entry {
      border-bottom: 1px solid #ddd;
      padding: 5px;
    }
  </style>
</head>
<body>
  <h1>🕒 Klocka In/Ut</h1>
  <button id="in">Klocka in</button>
  <button id="ut">Klocka ut</button>

  <div id="log">
    <h3>Stämplingar</h3>
    <div id="entries"></div>
  </div>

  <script>
    const entriesDiv = document.getElementById("entries");

    function loadEntries() {
      const entries = JSON.parse(localStorage.getItem("entries") || "[]");
      entriesDiv.innerHTML = "";
      entries.forEach(e => {
        const div = document.createElement("div");
        div.className = "entry";
        div.textContent = `${e.type} – ${new Date(e.time).toLocaleString("sv-SE")}`;
        entriesDiv.appendChild(div);
      });
    }

    function addEntry(type) {
      const entries = JSON.parse(localStorage.getItem("entries") || "[]");
      entries.push({ type, time: new Date().toISOString() });
      localStorage.setItem("entries", JSON.stringify(entries));
      loadEntries();
    }

    document.getElementById("in").onclick = () => addEntry("Klockat in");
    document.getElementById("ut").onclick = () => addEntry("Klockat ut");

    loadEntries();
  </script>
</body>
</html>
